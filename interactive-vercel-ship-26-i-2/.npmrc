# Hoist dependencies to the top-level node_modules so Turbopack's Node-style
# module resolution finds build-time plugins like @tailwindcss/postcss on CI
# (pnpm's default isolated layout can hide them from the build). Fixes the
# "Cannot find module '@tailwindcss/postcss'" GitHub Pages build failure.
shamefully-hoist=true
# Allow sharp's native build script (pnpm 10+ blocks build scripts by default and
# fatally errors: ERR_PNPM_IGNORED_BUILDS). .npmrc is read by every pnpm version,
# unlike the package.json "pnpm" field which pnpm 11 ignores.
only-built-dependencies[]=sharp
