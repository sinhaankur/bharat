.DS_Store
*.swp
*.swo
.idea/
.vscode/
node_modules/
*.log
package-lock.json

# news-feed.json IS committed now — the ingest-news.yml workflow scrapes RSS (link+snippet
# only) and auto-commits it every 6h so the live feed shows present India news.
# Curator's local export — feed into apply_curation.py, not committed.
curation-export.json
# Social auto-poster local state + secrets — NEVER commit keys.
.social_posted.json
.env
__pycache__/
# Generated Blender scenes — heavy build artifacts. The build_india_*_blender.py
# scripts + source geojson/ledger reproduce them exactly, so don't commit the output.
india_map.blend
india_districts.blend
*.blend1

# temple-forms preview renders — dev verification only; render_temple_previews.py
# regenerates them from the committed .glb models.
assets/temples-3d/_preview/

# font build venv
.venv-font/

# District gap work-list — local build artifact, regenerated by gen_coverage.py
# (coverage.json IS committed, since provenance.html fetches it at runtime).
coverage-gaps.csv

# Next app build output — regenerated by CI (deploy-app.yml), don't commit.
interactive-vercel-ship-26-i-2/out/
interactive-vercel-ship-26-i-2/.next/
# Dev-only symlink so the app can iframe the legacy .html pages locally.
# In production the iframes point at the atlas root instead (legacyUrl()),
# so this must NOT be committed (it's a circular ../.. symlink).
interactive-vercel-ship-26-i-2/public/legacy
